    lines:
    - speakerIndex: 0
      subtitle: "Hello... Sensei Yang? Sami sent me. I\u2019d like to join the dojo.
        I recently hurt my back."
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 1
      subtitle: "I know about your injury. Herniated discs, right? I had the same
        a few years back. You\u2019ve done well to get back on your feet."
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 0
      subtitle: Sami said you could help me fight in tournaments again.
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 1
      subtitle: "You\u2019re not ready for tournaments. But if you want to train
        and heal, you\u2019re welcome here."
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 0
      subtitle: But Sensei, I want to fight!
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 1
      subtitle: "That comes later. Today, show me where you are, then we\u2019ll
        spar. Come, join our training!"
      audioClip: {fileID: 0}
      waitForInput: 1
