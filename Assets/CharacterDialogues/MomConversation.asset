  m_Script: {fileID: 11500000, guid: 8835dfddad7d4ee41a303e58bc774c6d, type: 3}
  m_Name: MomConversation
  m_EditorClassIdentifier: 
  blocks:
  - phase: 1
    anyTimeOfDay: 1
    timeOfDay: 2
    anyDay: 1
    dayNumber: 0
    lines:
    - speakerIndex: 1
      subtitle: "Oh, sweetie... it\u2019s so good to see you up and about again.
        I was so scared I\u2019d lose you to that bed."
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 0
      subtitle: "I know, Mom. I\u2019m... I\u2019m better now. Listen, Sami told
        me about a new dojo, and I-"
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 1
      subtitle: "No! No more fighting, no more karate. You have a whole life ahead
        of you. I can\u2019t watch you break your back again!"
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 0
      subtitle: "Mom, please! It\u2019s the one thing I was ever good at. Without
        it I\u2019m nothing. I have to prove I\u2019m not beaten. I\u2019ll be careful,
        I swear. I\u2019ll learn to fight differently. Please, just let me try!"
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 1
      subtitle: ...
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 1
      subtitle: "Alright. Fine. But promise me you\u2019ll be safe. I don\u2019t
        think I could survive another call from the hospital."
      audioClip: {fileID: 0}
      waitForInput: 1
    - speakerIndex: 0
      subtitle: "I promise, Mom. Thank you. I won\u2019t let you down."
      audioClip: {fileID: 0}
      waitForInput: 1
