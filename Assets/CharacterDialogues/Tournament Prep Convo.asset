      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 1
      subtitle: "Hm. Your injury can\u2019t be ignored. You haven\u2019t yet learnt
        to fight with it."
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 0
      subtitle: Then teach me, Sensei. Please.
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 1
      subtitle: "Very well. There\u2019s a tournament in 10 days. Beat two of my
        students by then and I\u2019ll see about signing you up."
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 0
      subtitle: Oh thank you Sensei. I wont disappoint you.
      audioClip: {fileID: 0}
