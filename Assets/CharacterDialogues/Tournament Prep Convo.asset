    lines:
    - speakerIndex: 0
      subtitle: Good Morning Sensei
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 1
      subtitle: Hello Dastaan, You're here early, very good!
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 0
      subtitle: 'Sensei  I know you said I wasn''t ready, but please let me spar,
        I need to get back to the tournaments. I only have a couple years left, once
        I get into college, I wont have the time. '
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 0
      subtitle: I want to go as far as I can in this art, please help me
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 1
      subtitle: 'Hmm. Your injury must not be ignored. It is a part of you, and must
        be treated as such, but you have not yet learnt to fight like it is. '
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 0
      subtitle: Then teach me sensei
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 1
      subtitle: Oh alright, Theres a tournament in 10 days, if you can beat two of
        my students in that time, I shall see about letting you sign up.
      audioClip: {fileID: 0}
      waitForInput: 0
    - speakerIndex: 0
      subtitle: Oh thank you Sensei. I wont disappoint you.
      audioClip: {fileID: 0}
      waitForInput: 0
